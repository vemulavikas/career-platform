# Copy to .env (never commit .env)

# Shared between gateway (verifies tokens) and auth-service (signs tokens).
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000

# Shared between the gateway and every internal service (service-to-service auth).
INTERNAL_SERVICE_SECRET=replace-with-another-long-random-string-32-chars

# --- AI service (any OpenAI-compatible API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1000
CONTEXT_MAX_CHARS=12000
AI_RATE_LIMIT_PER_MIN=20

# --- AI service: one-shot generation used by the resume service ---
GENERATE_MAX_OUTPUT_TOKENS=3000

# --- Resume service ---
AI_REQUEST_TIMEOUT_MS=90000
MAX_CONCURRENT_GENERATIONS=5
GENERATION_QUEUE_LIMIT=20
GENERATE_RATE_LIMIT_PER_MIN=5
MAX_VERSIONS_PER_RESUME=30

# --- Booking service ---
BOOKING_RATE_LIMIT_PER_MIN=10
CONSULTATION_PRICE_CENTS=10000
CONSULTATION_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/bookings/success
STRIPE_CANCEL_URL=http://localhost:3000/bookings/cancel
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Optional: use MongoDB Atlas instead of the bundled mongo container ---
# Leave these commented to use the local container. Real values go ONLY in your untracked .env file.
# AUTH_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/auth_db?retryWrites=true&w=majority
# AI_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/ai_db?retryWrites=true&w=majority
# RESUME_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/resume_db?retryWrites=true&w=majority
# BOOKING_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/booking_db?retryWrites=true&w=majority
